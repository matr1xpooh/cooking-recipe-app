{
	"name": "cooking-recipe-app",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"migrate:aws": "tsx scripts/migrate-to-aws.ts",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"postinstall": "patch-package"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22",
		"@types/qrcode": "1.5.5",
		"@vitest/browser-playwright": "^4.1.8",
		"aws-sdk-client-mock": "^4.1.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"patch-package": "^8.0.1",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sst": "^3.19.3",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"svelte-kit-sst": "^2.49.8",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@aws-sdk/client-dynamodb": "^3.1168.0",
		"@aws-sdk/client-s3": "^3.1168.0",
		"@aws-sdk/client-textract": "^3.1164.0",
		"@aws-sdk/client-translate": "^3.1164.0",
		"@aws-sdk/lib-dynamodb": "^3.1168.0",
		"qrcode": "1.5.4"
	}
}
