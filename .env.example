# Copy to .env (git-ignored) and fill in. Never commit real values.

# Storage: "file" (local ./data, default) or the AWS backend once it exists.
STORE=file

# Sign-in. Set AUTH=off only for local development on your own machine.
AUTH=on

# Amazon Cognito user pool (hosted sign-in).
COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
COGNITO_DOMAIN=https://<domain-prefix>.auth.<region>.amazoncognito.com
COGNITO_CLIENT_ID=<app-client-id>

# Signs the session cookies. At least 32 random characters.
SESSION_SECRET=
